# Build artifacts - every profile builds into builds\build[-<profile>]\
builds/
tracker/build/
tools/fmg_patcher/build/

# Per-profile generated artifacts - regenerated by build.bat --<profile> from that
# profile's own game/mod data, so never committed. src/generated*/ is fully
# regenerated by the pipeline on every build, so none of it is committed
# (src/generated/ untracked 2026-08-31, data/ untracked 2026-09-22 - build
# artifacts like the rest; the committed inputs live in inputs/).
# Overlay profiles stage their merged source under data/<profile>/merged_src.
# (data/convergence + src/generated_convergence are the pre-split orphans - safe to
#  delete; kept here so they never leak in until then.)
src/generated/
src/generated_shared/
src/generated_vanilla/
src/generated_convergence/
src/generated_convergence2/
src/generated_convergence3/
src/generated_erte/
src/generated_goldenage/
src/generated_goldenage361/
src/generated_vins/
src/generated_reborn/
src/generated_graceborne/
src/generated_throne/

# Release + snapshot packages, zips, and the changelog all live under releases\
releases/
*.zip

# Backups
backup/
backup2/
backup3/

# Local debug scratch — never committed. ALL throwaway debug artifacts live here:
#   scratch/scripts/ — one-off investigation scripts (disasm probes, dumps, etc.)
#   scratch/out/     — their outputs (.txt/.out/.bin dumps, memory captures)
# New debug/research scripts and their outputs should be written here, not at the
# repo root or in tools/. Reusable diagnostic tools belong in tools/ (committed).
scratch/

# External dependencies
tools/DSMSPortable_src/

# Python
__pycache__/
*.pyc
*.pyo

# Local config (user-specific paths)
tools/config.ini

# IDE / OS
.vs/
.vscode/
.claude/
.idea/
Thumbs.db
desktop.ini

# data/ is the pipeline's WORKSPACE: every file under it (and under data/<profile>/) is written by a
# stage from the mod's own game files, and a clone regenerates all of it by building. The committed
# inputs that nothing regenerates live in inputs/ instead, which is why nothing here is listed by name.
data/

# Local pipeline hooks (machine-specific refinements; a stock checkout builds
# without them - see tools/finalize_pieces.py)
tools/local/

# One-off research outputs + intermediate versions (not used by current pipeline)

# Build logs (transient — from build.bat redirection)
snapshot-build.log
release-build.log
*-build.log

# Stray _-prefixed scratch in tools/ (belt-and-suspenders; the real home for
# one-off scripts/outputs is scratch/ — see above). A few reusable _*.py
# diagnostics (e.g. _check_aobs_new_build.py, _parse_minidump.py) are committed
# explicitly and are NOT ignored — these patterns only cover outputs.
tools/_*.txt
tools/_*.bin
tools/_*.json
tools/_*.out
tools/before_*.json
tools/before_*.bin
tools/before2_*.json
tools/addr_*.txt
tools/dump_*.bin

# Oodle shipped with Elden Ring — resolved via config.ini game_dir at runtime
oo2core_6_win64.dll
tools/oo2core_6_win64.dll

# FFDEC extraction/render outputs — large, reproducible from 02_120_worldmap*.gfx
assets/map_icons/rendered/
assets/map_icons/exported/
assets/map_icons/images/
assets/map_icons/scripts/
assets/map_icons/sprite_sheets/
assets/map_icons/by_iconId/
assets/map_icons/composed/

# Historical decompile snapshots — keep only worldmap_new_actual.xml (active source)
assets/map_icons/worldmap.xml
assets/map_icons/worldmap_398.xml
assets/map_icons/worldmap_399.xml
assets/map_icons/worldmap_400.xml
assets/map_icons/worldmap_modified.xml
assets/map_icons/worldmap_new_verify.xml

# Game sprite-sheet PNGs — large, reproducible via extract_subtextures.py
assets/map_icons/SB_*.png

# Sub-textures extracted from game — reproducible via extract_subtextures.py
assets/menu/KG_*.tga
assets/menu/MENU_*.tga
assets/menu/SB_*.tga
assets/menu/*.bak

# Release publishing notes (per-platform changelog texts, personal copy-paste aid).
# Lives in releases\ now (covered by releases/ above); the bare name is kept as a
# belt-and-suspenders guard in case anything writes one at the repo root.
releases/CHANGELOG.txt
CHANGELOG.txt

# Build/scan dashboard - kept local until it's finished (WIP tooling). Contains a
# secret VT API key (.vt_key) and a regenerable local SQLite DB, so the whole dir
# stays out of git for now. Re-track the source once the dashboard is done.
tools/dashboard/
